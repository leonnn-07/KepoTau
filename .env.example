# --- Supabase (Project Settings -> API Keys / Data API) ----------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public client key: the "anon" (legacy) or "publishable" key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) --------------------
# "service_role" (legacy) or "secret" key (sb_secret_...). Used only by the
# scheduled cleanup job at /api/cron/cleanup.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# Shared secret that Supabase Cron / Vercel Cron send as "Authorization: Bearer <CRON_SECRET>".
# Generate one with: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-string

# --- Optional -----------------------------------------------------------------
# Client-side max upload size in MB. Must not exceed the Supabase project's
# global upload limit (Storage -> Settings; 50 MB on the Free plan) or the
# bucket limit (500 MB in the migration).
NEXT_PUBLIC_MAX_UPLOAD_MB=50
